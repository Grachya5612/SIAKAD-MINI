              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/enrollments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": 2,\n  \"tahun_akademik\": \"2026/2027-Ganjil\"\n}"
            }
          }
        },
        {
          "name": "10. Batalkan KRS id 1 -> 204",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mhs_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/enrollments/1"
          }
        },
        {
          "name": "10. Tidak ditemukan -> 404",
          "request": {
