              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/enrollments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": 1,\n  \"tahun_akademik\": \"2026/2027-Ganjil\"\n}"
            }
          }
        },
        {
          "name": "9. Format tahun salah -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mhs_token}}"
              },
              {
                "key": "Content-Type",
